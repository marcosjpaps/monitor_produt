# Sem DATABASE_URL, usa SQLite local em data/drone.sqlite.
PORT=3000
PYTHON_PORT=8000
HOST=127.0.0.1
# Opcional: PostgreSQL externo. Não copie credenciais para arquivos públicos.
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/agrodrone
# PG_SSL=true
# AGGPS_DATA_PATH=C:/dados/AgGPS
# MASSEY_TRACTOR_FOLDER=C:/dados/Massey

# Produção: defina estas chaves nas variáveis sensíveis da Vercel.
# APP_ADMIN_EMAIL=seu-email
# APP_ADMIN_PASSWORD=senha-atual-de-acesso
# APP_SECRET_KEY=valor-aleatorio-de-no-minimo-32-caracteres
# APP_ENV=production
# Nunca envie .env para o GitHub.
