# =============================================================
# AgroTelemetry Monitor - Variáveis de Ambiente
# Copie este ficheiro para .env e preencha os valores reais
# NUNCA versione o ficheiro .env
# =============================================================

# -------------------------------------------------------
# BASE DE DADOS (Neon PostgreSQL Serverless)
# Obtenha em: https://console.neon.tech
# -------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require

# Parâmetros individuais (alternativa ao DATABASE_URL)
PGHOST=ep-XXXX.us-east-2.aws.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=your_neon_password_here
PGSSLMODE=require

# -------------------------------------------------------
# APLICAÇÃO FASTAPI
# -------------------------------------------------------
APP_ENV=production
APP_SECRET_KEY=change_this_to_a_long_random_secret_key_min_32_chars
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# -------------------------------------------------------
# LIMITES DE UPLOAD E SEGURANÇA
# -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.zip,.rar,.jdl,.agf,.shp,.kml,.geojson
UPLOAD_DIR=/tmp/agro_uploads

# -------------------------------------------------------
# BASE DE DADOS SQLITE LOCAL (Desenvolvimento)
# Em produção use DATABASE_URL acima
# -------------------------------------------------------
SQLITE_DB_PATH=./telemetria.db
MASSEY_DB_PATH=./data/trimble_data.db

# -------------------------------------------------------
# PASTAS DE DADOS LOCAIS (Apenas Desenvolvimento)
# -------------------------------------------------------
AGGPS_DATA_PATH=./AgGPS_Data
JD_DATA_PATH=./samples
MASSEY_TRACTOR_FOLDER=./data/massey

# -------------------------------------------------------
# JDLINK API (John Deere Operations Center)
# Obtenha em: https://developer.deere.com
# -------------------------------------------------------
JDLINK_CLIENT_ID=your_john_deere_client_id
JDLINK_CLIENT_SECRET=your_john_deere_client_secret
JDLINK_BASE_URL=https://partnerapi.deere.com/platform

# -------------------------------------------------------
# CORS E SEGURANÇA WEB
# -------------------------------------------------------
CORS_ORIGINS=https://seu-dominio.vercel.app,http://localhost:3000
