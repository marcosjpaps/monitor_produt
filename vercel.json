{
  "version": 2,
  "name": "agrotelemetry-monitor",
  "buildCommand": "echo 'Static frontend - no build step required'",
  "outputDirectory": "frontend",
  "installCommand": "npm install",
  "framework": null,
  "routes": [
    {
      "src": "/api/talhoes",
      "dest": "/api/talhoes.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/importacoes",
      "dest": "/importacoes.html"
    },
    {
      "src": "/johndeere",
      "dest": "/johndeere.html"
    },
    {
      "src": "/dashboard",
      "dest": "/johndeere.html"
    },
    {
      "src": "/jdl",
      "dest": "/johndeere.html"
    },
    {
      "src": "/jacto",
      "dest": "/jacto.html"
    },
    {
      "src": "/massey",
      "dest": "/massey.html"
    },
    {
      "src": "/massei",
      "dest": "/massey.html"
    },
    {
      "src": "/studio",
      "dest": "/studio.html"
    },
    {
      "src": "/isoxml",
      "dest": "/studio.html"
    },
    {
      "src": "/portal",
      "dest": "/index.html"
    },
    {
      "src": "/portal.html",
      "dest": "/index.html"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 512,
      "excludeFiles": "{node_modules/**,telemetria.db,*.zip,*.js,*.html,samples/**,AgGPS_Data/**,ENC__ARQUIVOS/**,scratch/**,open-dronelog/**,.venv/**,frontend/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
